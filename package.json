{
  "name": "rng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:coverage": "c8 --all --include='src/**/*.ts' --check-coverage --branches=100 --reporter=text node --import tsx --test test/*.test.ts test/*.test.mjs",
    "verify": "node --import tsx scripts/verify-chain.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
