{
  "name": "rng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "node --import tsx scripts/verify-chain.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "typebox": "^1.3.26"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
